<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/blanco_uf"
    android:elevation="5dp">

    <Button
        android:id="@+id/ir_ini"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:text="@string/inicio_uf"
        android:textAllCaps="false"
        android:textSize="12sp"
        android:textColor="@color/azul_osc_uf"
        android:padding="0dp" />

    <Button
        android:id="@+id/ir_cat"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:text="@string/catalogo_uf"
        android:textAllCaps="false"
        android:textSize="12sp"
        android:textColor="@color/azul_osc_uf"
        android:padding="0dp" />

    <Button
        android:id="@+id/ir_car"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:text="@string/carrito_uf"
        android:textAllCaps="false"
        android:textSize="12sp"
        android:textColor="@color/azul_osc_uf"
        android:padding="0dp" />

</LinearLayout>
