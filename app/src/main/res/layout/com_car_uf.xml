<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_uf">

 <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:orientation="vertical"
     android:background="@color/azul_osc_uf"
     android:padding="18dp">

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/marca_uf"
      android:textColor="@color/blanco_uf"
      android:textSize="13sp"
      android:textStyle="bold"
      android:letterSpacing="0.17" />

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="5dp"
      android:text="@string/mi_carrito_uf"
      android:textColor="@color/blanco_uf"
      android:textSize="22sp"
      android:textStyle="bold" />

 </LinearLayout>

 <ScrollView
     android:layout_width="match_parent"
     android:layout_height="0dp"
     android:layout_weight="1"
     android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="18dp">

   <TextView
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="0dp"
       android:text="@string/revisar_prendas_uf"
       android:textSize="14sp"
       android:textColor="@color/gris_uf"
       android:lineSpacingExtra="3dp" />

   <LinearLayout
       android:id="@+id/lista_uf"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="15dp"
       android:orientation="vertical" />

   <LinearLayout
       style="@style/TarjUf"
       android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:text="@string/total_compra_uf"
        android:textSize="15sp"
        android:textColor="@color/gris_uf"
        android:lineSpacingExtra="3dp" />

    <TextView
        android:id="@+id/txt_tot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="@string/venta_cero_uf"
        android:textSize="23sp"
        android:textColor="@color/azul_osc_uf"
        android:textStyle="bold"
        android:lineSpacingExtra="3dp" />

    <Button
        android:id="@+id/btn_pag"
        style="@style/BotonUf"
        android:layout_marginTop="10dp"
        android:text="@string/simular_compra_uf" />

   </LinearLayout>

  </LinearLayout>

 </ScrollView>

 <include layout="@layout/barra_com_uf" />

</LinearLayout>
