   <LinearLayout style="@style/TarjUf" android:orientation="vertical"><TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pedidos registrados" android:textSize="15sp" android:textColor="@color/gris_uf"  android:layout_marginTop="0dp" android:lineSpacingExtra="3dp"/><TextView android:id="@+id/txt_ped" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0" android:textSize="27sp" android:textColor="@color/azul_uf" android:textStyle="bold" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp"/><TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Valor acumulado" android:textSize="15sp" android:textColor="@color/gris_uf"  android:layout_marginTop="15dp" android:lineSpacingExtra="3dp"/><TextView android:id="@+id/txt_tot" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="$ 0" android:textSize="27sp" android:textColor="@color/azul_uf" android:textStyle="bold" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp"/></LinearLayout><TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Detalle de pedidos" android:textSize="18sp" android:textColor="@color/texto_uf" android:textStyle="bold" android:layout_marginTop="15dp" android:lineSpacingExtra="3dp"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/lista_uf" android:layout_marginTop="12dp"></LinearLayout>
  </LinearLayout>
