  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reporte de ventas" android:textColor="@color/blanco_uf" android:textSize="22sp" android:textStyle="bold" android:layout_marginTop="5dp"/>
 </LinearLayout>
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
