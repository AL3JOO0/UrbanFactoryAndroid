<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_uf">

 <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:orientation="vertical"
     android:background="@color/azul_osc_uf"
     android:padding="18dp">

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/marca_uf"
      android:textColor="@color/blanco_uf"
      android:textSize="13sp"
      android:textStyle="bold"
      android:letterSpacing="0.17" />

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="5dp"
      android:text="@string/lema_uf"
      android:textColor="@color/blanco_uf"
      android:textSize="22sp"
      android:textStyle="bold" />

 </LinearLayout>

 <ScrollView
     android:layout_width="match_parent"
     android:layout_height="0dp"
     android:layout_weight="1"
     android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="18dp">

   <ImageView
       android:id="@+id/img_logo"
       android:layout_width="match_parent"
       android:layout_height="155dp"
       android:layout_marginTop="8dp"
       android:contentDescription="@string/logo_desc_uf"
       android:scaleType="fitCenter"
       android:src="@drawable/logo_uf" />

   <TextView
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="18dp"
       android:text="@string/ropa_urbana_uf"
       android:textSize="19sp"
       android:textColor="@color/azul_osc_uf"
       android:textStyle="bold"
       android:lineSpacingExtra="3dp" />

   <TextView
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="6dp"
       android:text="@string/categorias_uf"
       android:textSize="15sp"
       android:textColor="@color/gris_uf"
       android:lineSpacingExtra="3dp" />

  </LinearLayout>

 </ScrollView>

</LinearLayout>
