<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_uf">

 <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:orientation="vertical"
     android:background="@color/azul_osc_uf"
     android:padding="18dp">

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/marca_uf"
      android:textColor="@color/blanco_uf"
      android:textSize="13sp"
      android:textStyle="bold"
      android:letterSpacing="0.17" />

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="5dp"
      android:text="@string/detalle_prenda_uf"
      android:textColor="@color/blanco_uf"
      android:textSize="22sp"
      android:textStyle="bold" />

 </LinearLayout>

 <ScrollView
     android:layout_width="match_parent"
     android:layout_height="0dp"
     android:layout_weight="1"
     android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="18dp">

   <TextView
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="0dp"
       android:text="@string/seleccion_prenda_uf"
       android:textSize="14sp"
       android:textColor="@color/gris_uf"
       android:lineSpacingExtra="3dp" />

   <LinearLayout
       style="@style/TarjUf"
       android:orientation="vertical">

    <ImageView
        android:id="@+id/img_prod"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/img_jean_uf"
        android:contentDescription="@string/imagen_producto_uf"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/txt_nom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/producto_uf"
        android:textSize="23sp"
        android:textColor="@color/texto_uf"
        android:textStyle="bold"
        android:lineSpacingExtra="3dp" />

    <TextView
        android:id="@+id/txt_pre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/venta_cero_uf"
        android:textSize="20sp"
        android:textColor="@color/azul_uf"
        android:textStyle="bold"
        android:lineSpacingExtra="3dp" />

    <TextView
        android:id="@+id/txt_des"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/descripcion_producto_uf"
        android:textSize="14sp"
        android:textColor="@color/gris_uf"
        android:lineSpacingExtra="3dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/talla_uf"
        android:textSize="14sp"
        android:textColor="@color/texto_uf"
        android:textStyle="bold"
        android:lineSpacingExtra="3dp" />

    <Spinner
        android:id="@+id/sp_tal"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/campo_uf"
        android:padding="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/color_uf"
        android:textSize="14sp"
        android:textColor="@color/texto_uf"
        android:textStyle="bold"
        android:lineSpacingExtra="3dp" />

    <Spinner
        android:id="@+id/sp_col"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/campo_uf"
        android:padding="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/cantidad_uf"
        android:textSize="14sp"
        android:textColor="@color/texto_uf"
        android:textStyle="bold"
        android:lineSpacingExtra="3dp" />

    <EditText
        android:id="@+id/edt_can"
        style="@style/CampoUf"
        android:layout_marginTop="6dp"
        android:hint="@string/uno_uf"
        android:inputType="number"
        android:importantForAutofill="no" />

    <TextView
        android:id="@+id/txt_sto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/disponibilidad_uf"
        android:textSize="13sp"
        android:textColor="@color/verde_uf"
        android:lineSpacingExtra="3dp" />

    <Button
        android:id="@+id/btn_agr"
        style="@style/BotonUf"
        android:layout_marginTop="10dp"
        android:text="@string/agregar_carrito_uf" />

   </LinearLayout>

   <Button
       android:id="@+id/btn_vol"
       style="@style/BotonBorUf"
       android:layout_marginTop="10dp"
       android:text="@string/volver_catalogo_uf" />

  </LinearLayout>

 </ScrollView>

 <include layout="@layout/barra_com_uf" />

</LinearLayout>
